# --- NeonDB (Postgres) ---
# DATABASE_URL: connection string "pooled" (host mengandung -pooler). Dipakai aplikasi saat runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: connection string langsung (tanpa -pooler). Dipakai Prisma untuk migrasi.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Neon Object Storage (S3-compatible; khusus server, JANGAN pakai awalan NEXT_PUBLIC_) ---
# Ambil dari: neon credentials create --scope storage:read --scope storage:write
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Endpoint branch, dari: GET /projects/{id}/branches/{id}/storage  (field s3_endpoint)
AWS_ENDPOINT_URL_S3="https://br-xxxx.storage.c-N.REGION.aws.neon.tech"
# Region storage: us-east-2, us-east-1, eu-central-1, atau ap-southeast-1
AWS_REGION="ap-southeast-1"
# Nama bucket (private). Buat dengan: neon buckets create struk-kas
STORAGE_BUCKET="struk-kas"

# --- Admin ---
# Password admin awal. Setelah diganti lewat halaman Pengaturan, nilai ini tidak dipakai lagi.
ADMIN_PASSWORD=""
# Kunci penanda tangan cookie sesi. Buat dengan: openssl rand -base64 32
SESSION_SECRET=""
