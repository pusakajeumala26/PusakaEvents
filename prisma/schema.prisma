generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  L
  P
}

enum PayStatus {
  BELUM
  MENUNGGU
  TERVERIFIKASI
  DITOLAK
}

enum EventType {
  DAFTAR
  IMPOR
  UPLOAD
  KIRIM_ULANG
  DISETUJUI
  DITOLAK
}

enum CleanupStatus {
  OK
  PARTIAL
}

model Member {
  id           String        @id @default(uuid())
  name         String
  /// Kode negara, mis. "+62"
  countryCode  String
  /// Hanya digit, tanpa nol di depan dan tanpa kode negara
  phone        String
  /// Subjek / deskripsi singkat dari anggota
  subject      String        @default("")
  gender       Gender
  /// Null untuk anggota hasil impor admin sampai ia membuat password sendiri
  passwordHash String?
  status       PayStatus     @default(BELUM)
  /// Alasan penolakan terakhir (hanya relevan saat status DITOLAK)
  rejectReason String?
  /// Key objek struk di Neon Object Storage, mis. "struk/<id>/1730000000000.webp"
  receiptKey   String?
  receiptAt    DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  events       MemberEvent[]

  @@unique([countryCode, phone])
  @@index([createdAt])
  @@index([status])
}

model MemberEvent {
  id        String    @id @default(uuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type      EventType
  note      String?
  createdAt DateTime  @default(now())

  @@index([memberId, createdAt])
}

/// Baris tunggal (id = 1)
model Setting {
  id                Int       @id @default(1)
  letingName        String    @default("Pusaka Jeumala")
  /// Nominal kas per anggota (Rupiah), sekali bayar
  amount            Int       @default(10000)
  /// Jumlah anggota yang ditargetkan
  target            Int       @default(36)
  deadline          DateTime?
  registrationOpen  Boolean   @default(true)
  bankName          String    @default("BSI")
  accountNumber     String    @default("7366090325")
  accountName       String    @default("Raisya Zumara")
  adminPasswordHash String?
  /// Dinaikkan setiap password admin diganti, supaya sesi lama tidak berlaku
  adminPwVersion    Int       @default(0)
  periodName        String    @default("Periode 1")
  periodStartedAt   DateTime  @default(now())
}

model Period {
  id               String        @id @default(uuid())
  name             String
  amount           Int
  targetCount      Int
  startedAt        DateTime
  closedAt         DateTime      @default(now())
  totalMembers     Int
  verifiedCount    Int
  pendingCount     Int
  rejectedCount    Int
  unpaidCount      Int
  verifiedTotal    Int
  receiptCount     Int
  cleanupStatus    CleanupStatus @default(OK)

  @@index([closedAt])
}

enum FeedbackSync {
  QUEUED
  SENT
  FAILED
}

/// Masukan publik. Selalu disimpan di sini lebih dulu, lalu dikirim ke portfolio lewat antrean.
model Feedback {
  id            String       @id @default(uuid())
  name          String
  role          String?
  message       String
  rating        Int
  /// Key foto profil (prefix "feedback/") di Neon Object Storage; tidak dikirim ke portfolio
  avatarKey     String?
  syncStatus    FeedbackSync @default(QUEUED)
  attempts      Int          @default(0)
  /// Jenis kegagalan terakhir: dns, network, timeout, unauthorized, rate_limited, server, invalid
  lastError     String?
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  /// Ada percobaan yang hasilnya tidak pasti (timeout/5xx): kemungkinan sudah diterima portfolio
  uncertain     Boolean      @default(false)
  remoteId      String?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([syncStatus, nextAttemptAt])
  @@index([createdAt])
}

/// Baris tunggal (id = 1): koneksi MCP portfolio yang diatur dari halaman Pengaturan admin
model PortfolioConnection {
  id           Int       @id @default(1)
  url          String?
  /// API key terenkripsi AES-256-GCM; tidak pernah dikirim ke browser
  keyEnc       String?
  /// Empat karakter terakhir key untuk tampilan tersamar
  keyHint      String?
  connected    Boolean   @default(false)
  lastTestAt   DateTime?
  lastTestOk   Boolean?
  lastTestKind String?
  lastTestMs   Int?
  lastTestNote String?
  updatedAt    DateTime  @updatedAt
}
